{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/db/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|src/|sw\\.js|workbox-.*|manifest\\.webmanifest|registerSW\\.js|pwa-.*|apple-touch-icon\\.png|icon\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
